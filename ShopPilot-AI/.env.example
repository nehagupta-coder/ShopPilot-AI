# Server
PORT=4000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# MongoDB — use mongodb://127.0.0.1:27017/shopilot or a MongoDB Atlas URI.
# Leave as "memory" to run the built-in in-memory store (no Mongo required).
MONGO_URI=memory

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI provider: "mock" works offline. Use "openai" or "groq" with a real key.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# Optional Groq example:
# AI_PROVIDER=groq
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=https://api.groq.com/openai/v1
